# ==============================================================================
# AMAZON VANILLA - PROYECTO CULTIVO WAORANI (ITEC ECUADOR)
# ARCHIVO DE PLANTILLA DE VARIABLES DE ENTORNO (.env.example)
# Copia este archivo como .env y rellena tus claves reales.
# ==============================================================================

NODE_ENV=development
PORT=3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Credenciales de Administrador
ADMIN_EMAIL=admin@itec-vanilla.org
ADMIN_PASSWORD=
JWT_SECRET=
SESSION_SECRET=

# GitHub API
GITHUB_TOKEN=
GITHUB_REPO_OWNER=
GITHUB_REPO_NAME=

# Vercel Deployment
VERCEL_TOKEN=
VERCEL_ORG_ID=
VERCEL_PROJECT_ID=
VERCEL_WEBHOOK_SECRET=

# Base de datos (PostgreSQL / Supabase / Neon / Prisma)
DATABASE_URL=
DIRECT_URL=

# Almacenamiento multimedia para fotos de campo
BLOB_READ_WRITE_TOKEN=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Notificaciones por Correo
NOTIFICATION_EMAIL_TO=
NOTIFICATION_EMAIL_FROM=
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false

# Notificaciones por WhatsApp
WHATSAPP_ADMIN_PHONE=
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER=

# Parámetros del Sistema
MAX_UPLOAD_SIZE_MB=10
DEFAULT_EXPORT_FORMAT=pdf
